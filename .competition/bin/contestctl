#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${CONTESTCTL_PY:-}" ]]; then
  if [[ ! -f "$CONTESTCTL_PY" ]]; then
    echo "CONTESTCTL_PY does not point to a file: $CONTESTCTL_PY" >&2
    exit 127
  fi
  exec python3 "$CONTESTCTL_PY" "$@"
fi

candidates=()
if [[ -n "${CODEX_HOME:-}" ]]; then
  candidates+=("$CODEX_HOME/skills/competition-war-room/scripts/contestctl.py")
fi
if [[ -n "${HOME:-}" ]]; then
  candidates+=(
    "$HOME/.codex/skills/competition-war-room/scripts/contestctl.py"
    "$HOME/.agents/skills/competition-war-room/scripts/contestctl.py"
  )
fi

for candidate in "${candidates[@]}"; do
  if [[ -f "$candidate" ]]; then
    exec python3 "$candidate" "$@"
  fi
done

cat >&2 <<'EOF'
contestctl is optional maintainer tooling and was not found.
Set CONTESTCTL_PY to competition-war-room/scripts/contestctl.py, or install the skill.
Judge-facing workflows are self-contained: use `make audit` or `make reproduce`.
EOF
exit 127
